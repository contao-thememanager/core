{
  "name": "contao-thememanager/core",
  "type": "contao-bundle",
  "description": "Contao Theme-Manager",
  "keywords": [
    "contao",
    "theme",
    "css",
    "manager"
  ],
  "homepage": "https://www.contao-thememanager.com/",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Oveleon",
      "homepage": "https://oveleon.de/",
      "role": "Developer"
    },
    {
      "name": "Sebastian Zoglowek",
      "homepage": "https://github.com/zoglo",
      "role": "Developer"
    },
    {
      "name": "Daniele Sciannimanica",
      "homepage": "https://github.com/doishub",
      "role": "Developer"
    },
    {
      "name": "Fabian Ekert",
      "homepage": "https://github.com/eki89",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/contao-thememanager/core/issues",
    "source": "https://github.com/contao-thememanager/core",
    "forum": "https://github.com/contao-thememanager/core/discussions",
    "docs": "https://docs.contao-thememanager.com/"
  },
  "require": {
    "php": "^8.1",
    "ext-dom": "*",
    "ext-simplexml": "*",
    "contao/core-bundle": "^4.13.54 || ^5.3.32",
    "madeyourday/contao-rocksolid-custom-elements": "^2.4.13",
    "madeyourday/contao-rocksolid-icon-picker": "^2.1.2",
    "oveleon/contao-component-style-manager": "^3.8",
    "oveleon/contao-config-driver-bundle": "^1.5",
    "oveleon/contao-theme-compiler-bundle": "^1.11",
    "doctrine/dbal": "^3.3",
    "symfony/config": "^5.4 || ^6.4 || ^7.2",
    "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.2",
    "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.2",
    "symfony/filesystem": "^5.4 || ^6.4 || ^7.2",
    "symfony/http-foundation": "^5.4 || ^6.4 || ^7.2",
    "symfony/http-kernel": "^5.4 || ^6.4 || ^7.2",
    "symfony/security-core": "^5.4 || ^6.4 || ^7.2"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.3.1",
    "contao/test-case": "^5.1",
    "phpunit/phpunit": "^9.5.19",
    "symfony/phpunit-bridge": "^5.4 || ^6.0",
    "shipmonk/composer-dependency-analyser": "^1.6"
  },
  "suggest": {
    "contao-thememanager/ctm-tiny-slider": "For integrating the well known tiny-slider into the thememanager"
  },
  "conflict": {
    "contao/core": "*",
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "ContaoThemeManager\\Core\\": "src/"
    },
    "classmap": [
      "contao/"
    ],
    "exclude-from-classmap": [
      "contao/config/",
      "contao/dca/",
      "contao/languages/",
      "contao/templates/"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.1.x-dev"
    },
    "contao-manager-plugin": "ContaoThemeManager\\Core\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "php-http/discovery": true,
      "contao/manager-plugin": true
    }
  },
  "scripts": {
    "depcheck": "@php vendor/bin/composer-dependency-analyser --config=depcheck.php"
  }
}
