{% extends "@Contao/content_element/downloads.html.twig" %}

{% set sm = styleManager(data) %}
{% set listClasses = sm.prepare('eList').format(' %s') %}
{% set linkClasses = sm.prepare('eLink').exclude(['icon','direction']).format(' %s') %}
{% set spanClasses = sm.prepare('eLink',['icon','direction']).format(' %s') %}

{% block list_attributes %}
    {{ list_attributes.addClass('c_list').addClass(listClasses) }}
{% endblock %}

{% block download_link_attributes %}
    {{ download_link_attributes.addClass('c_link').addClass(linkClasses) }}
{% endblock %}

{%- block download_link_inner %}
    <span class="name{{ spanClasses }}">{{ text }}</span>
{% endblock -%}

{% block download_component %}
    {% if download.show_file_previews is defined and download.show_file_previews %}
        <span class="dl-reverse">
            {{ parent() }}
        </span>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
