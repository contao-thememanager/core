{% extends "@Contao/content_element/_base.html.twig" %}

{% set sm = styleManager(data) %}
{% set is_list = type != 'gallery' and (sm.get('eGridList') is not empty or 'init-slider' in element_css_classes) %}

{% set headline2 = data.headline2|deserialize %}
{% set headline_classes = sm.prepare('gHeadline').format('c_headline %s') %}

{% set inside_attributes = attrs()
    .addClass([
        type != 'headline' ? 'inside' : headline_classes,
        sm.get(['cLayout', 'eLayout', 'cText', 'eText', 'ePadding', 'cSpacing', 'cPadding', 'cBackground', 'eBackground']),
        is_list ? sm.prepare('cLayout', ['imageText']).format('image_text') : '',
        is_list ? sm.prepare('cLayout', ['iconText']).format('icon_text') : '',
    ])
    .mergeWith(inside_attributes|default)
%}

{% set list_attributes = attrs()
    .addClass(['c_list', 'grid-list', sm.get('eGridList')])
    .setIfExists('data-slider-config', sm.prepare('sliderConfig', ['preset']).format('%s', 'json'))
    .setIfExists('data-slider', sm.prepare('slider').format('%s', 'json'))
    .setIfExists('data-slider-xs', sm.prepare('sliderXS').format('%s', 'json'))
    .setIfExists('data-slider-s', sm.prepare('sliderS').format('%s', 'json'))
    .setIfExists('data-slider-m', sm.prepare('sliderM').format('%s', 'json'))
    .setIfExists('data-slider-l', sm.prepare('sliderL').format('%s', 'json'))
    .setIfExists('data-slider-xl', sm.prepare('sliderXL').format('%s', 'json'))
    .mergeWith(list_attributes|default)
%}

{# Add legacy classes for certain types #}
{% set legacy_core_elements = ['headline', 'text', 'list', 'image', 'youtube', 'vimeo'] %}
{% set legacy_rsce_elements = ['rsce_hyperlink_list', 'rsce_icon', 'rsce_icon_text', 'rsce_icon_text_list', 'rsce_image_list', 'rsce_image_text', 'rsce_image_text_list', 'rsce_text', 'rsce_text_list'] %}
{% set legacy_elements = legacy_core_elements|merge(legacy_rsce_elements) %}

{% if type in legacy_elements %}
    {% set attributes = attrs(attributes|default).addClass('ce_' ~ type) %}
{% endif %}

{% set figure_attributes = attrs(figure_attributes|default)
    .addClass('image_container', figure.media.type|default is empty)
%}

{# Base #}
{%- block inner %}
    <{{ inside_tag_name|default('div') }}{{ inside_attributes }}>
        {% if headline.text or headline2.value|default %}
            {{ block('headline_component') }}
        {% endif %}
        {% if is_list %}
            <div{{ list_attributes }}>
        {% endif %}
        {% block content %}{% endblock %}
        {% if is_list %}
            </div>
        {% endif %}
    </{{ inside_tag_name|default('div') }}>
{% endblock %}

{# Headline classes #}
{%- block headline_attributes %}
    {{ attrs(headline.attributes|default).addClass(data.headlineStyle) }}
{% endblock -%}

{# Headline Wrapper and Headline2 #}
{% block headline_component %}
    <div class="{{ headline_classes }}">
        {{ parent() }}
        {% if headline2.value %}
            {% block headline_two_component %}
                {% set headline_two_tag_name = headline2.unit|default('h3') %}
                {% set headline_two_attributes = attrs(headline2.attributes|default)
                    .addClass(data.headline2Style)
                %}
                <{{ headline_two_tag_name }}{% block headline_two_attributes %}{{ headline_two_attributes }}{% endblock %}>
                    {%- block headline_two_inner -%}
                        {{ headline2.value|insert_tag_raw }}
                    {%- endblock -%}
                </{{ headline_two_tag_name }}>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}
