{% use "@Contao/theme_manager/component/_text.html.twig" %}

{% block media_text_component %}
    {% set item = item|default(_context) %}

    {# Media #}
    {% block media_inner %}{% endblock %}

    {# Text #}
    {% block text_inner %}
        {% with { text: item.text|default } %}{{ block('text_component') }}{% endwith %}
    {% endblock %}

{% endblock %}
