{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/theme_manager/component/_media_text.html.twig" %}
{% use "@Contao/theme_manager/component/_icon.html.twig" %}

{% set attributes = attrs(attributes|default).addClass(['icon_text', 'item']) %}

{% if url|default and not linkText|default %}
    {% set inside_tag_name = 'a' %}
    {% set inside_attributes = attrs()
        .mergeWith(inside_attributes|default)
        .set('href', url|insert_tag_raw)
        .setIfExists('title', titleText|insert_tag_raw)
        .setIfExists('rel', rel|default)
        .set('target', '_blank', target|default and not rel|default)
    %}
{% endif %}

{% block content %}
    {{ block('media_text_component') }}
{% endblock %}

{% block media_inner %}
    {{ block('icon_component') }}
{% endblock %}
