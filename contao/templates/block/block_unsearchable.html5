<?php

$sm = $this->styleManager;
$isList = !empty($sm->get('eGridList')) || str_contains($this->class, 'init-slider');

$this->wrapperAttributes = $this
  ->attr($this->cssID)
  ->addClass([$this->class, 'block'])
  ->addStyle($this->style ?? '')
  ->mergeWith($this->wrapperAttributes)
;

$headlineWrapperClasses = $sm->prepare('gHeadline')->format(' %s"');

$this->insideAttributes = $this
  ->attr($this->cssID)
  ->addClass([
    $sm->prepare('cLayout',['imageText'])->format('image_text'),
    $sm->prepare('cLayout',['iconText'])->format('icon_text'),
    $sm->get(['cLayout', 'eLayout', 'cText', 'eText', 'ePadding', 'cSpacing', 'cPadding', 'cBackground', 'eBackground'])
  ])
  ->setIfExists('style', $this->style)
  ->mergeWith($this->insideAttributes)
;

$this->listAttributes = $this
  ->attr()
  ->addClass(['c_list', 'grid-list', $sm->get('eGridList')])
  ->setIfExists('data-slider-config', $sm->prepare('sliderConfig', ['preset'])->format('%s', 'json'))
  ->setIfExists('data-slider', $sm->prepare('slider')->format('%s', 'json'))
  ->setIfExists('data-slider-xs', $sm->prepare('sliderXS')->format('%s', 'json'))
  ->setIfExists('data-slider-s', $sm->prepare('sliderS')->format('%s', 'json'))
  ->setIfExists('data-slider-m', $sm->prepare('sliderM')->format('%s', 'json'))
  ->setIfExists('data-slider-l', $sm->prepare('sliderL')->format('%s', 'json'))
  ->setIfExists('data-slider-xl', $sm->prepare('sliderXL')->format('%s', 'json'))
  ->mergeWith($this->listAttributes)
;

?>

<?php $this->block('wrapper'); ?>
<!-- indexer::stop -->
  <div<?= $this->wrapperAttributes ?>>
    <div<?= $this->insideAttributes ?>>

      <?php $this->block('headline'); ?>
        <?php if ($this->headline || $this->headline2): ?>
          <div<?= $headlineWrapperClasses ?>>
        <?php endif; ?>

        <?php if ($this->headline): ?>
          <<?= $this->hl ?><?= $this->headlineStyle ? ' class="'.$this->headlineStyle.'"' : '' ?>><?= $this->headline ?></<?= $this->hl ?>>
        <?php endif; ?>

        <?php if ($this->headline2): ?>
          <<?= $this->hl2 ?><?= $this->headline2Style ? ' class="'.$this->headline2Style.'"' : '' ?>><?= $this->headline2 ?></<?= $this->hl2 ?>>
        <?php endif; ?>

        <?php if ($this->headline || $this->headline2): ?>
          </div>
        <?php endif; ?>
      <?php $this->endblock(); ?>

      <?php if ($isList): ?>
        <div<?= $this->listAttributes ?>>
      <?php endif; ?>

      <?php $this->block('content'); ?>
      <?php $this->endblock(); ?>

      <?php if ($isList): ?>
        </div>
      <?php endif; ?>

      <?php if ($this->pagination): ?>
        <div class="pagination-container<?=$sm->prepare('gPagination')->format(' %s')?>">
          <?php $this->block('pagination'); ?>
          <?php $this->endblock(); ?>
        </div>
      <?php endif; ?>

    </div>
    <?php $this->block('script'); ?>
    <?php $this->endblock(); ?>
  </div>
  <!-- indexer::continue -->
<?php $this->endblock(); ?>
